#!/bin/bash
set -e

# Build frontend
npm run build

# Copy dist to server
scp -r dist/ journal@journal.pkhleb.com:~/journal/frontend/dist/

# Pull backend files from server
scp -r journal@journal.pkhleb.com:~/journal/backend/app/ ../backend/


# Commit to git
cd ..
git add -A
git status
echo ""
read -p "Commit message: " msg
git commit -m "$msg"
git push

# Rebuild and restart frontend container on server
ssh journal@journal.pkhleb.com "cd ~/journal && git pull && docker compose up -d --build frontend"
